[Unit]
Description=Bomvakt rules (applies the rules from bomvakt.com/konto/regler)
Documentation=man:bomvakt(1) https://bomvakt.com
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/bomvakt/bomvakt.py --conf /etc/bomvakt/bomvakt.conf rules --quiet
SyslogIdentifier=bomvakt-rules
StateDirectory=bomvakt-rules

# Root, because it writes its own file in /etc/nginx/conf.d, reloads nginx
# and writes robots.txt into web roots (anywhere, e.g. /var/www or /home).
# /usr, /boot and the rest of /etc stay read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=-/etc/nginx/conf.d
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
